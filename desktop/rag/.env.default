# Default RAG configuration, seeded into the app's per-user data folder the
# first time it runs (see main.js's ensureRagDataDir). After that, this file
# is NOT read again — edit the real .env in the app's data folder instead
# (Settings > "Open data folder" once that's wired up, or find it via
# Electron's app.getPath("userData")/rag-data/.env on this machine).

# Which chat provider to use — uncomment ONE:
LLM_PROVIDER=llama

# LLM_PROVIDER=openrouter
# LLM_PROVIDER=gemini

# Chat model — your llama-server instance (used when LLM_PROVIDER=llama)
LLM_HOST=http://196.41.44.205:8080
LLM_MODEL=llama-3.1-8b
# or
#LLM_MODEL=lfm2.5-8b-a1b
LLM_API_KEY=01fb97a2211cfb653034d374284f1b0b145a73fa93770c15f144353a939576ed           # only needed if llama-server is behind auth

# OpenRouter (used when LLM_PROVIDER=openrouter) — get a free key at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# NVIDIA built this specifically for the speed/accuracy tradeoff — MoE
# with only 3B active params (of 30B total), up to ~4x output speed of
# similar-sized models, and real tools/tool_choice support (needed for
# this app's agent loop). Pinning it instead of the auto-router below
# avoids randomly landing on a slower/overloaded free model per call.
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_MODEL=z-ai/glm-5.2:free
# OPENROUTER_MODEL=thinkingmachines/inkling-small:free
# OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_MODEL=poolside/laguna-xs-2.1:free
# OPENROUTER_MODEL=cohere/north-mini-code:free
# SHOW_REASONING=true     # print the model's reasoning trace before the answer

# Gemini (used when LLM_PROVIDER/AGENT_LLM_PROVIDER/KNOWLEDGE_PROVIDER/
# CONFIG_PROVIDER=gemini) — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY="AQ.Ab8RN6Kjc_oXE7M3V2Oet6Ycy9EDdkjh1JQqrFRjCsWXQAyjJA"
GEMINI_MODEL=gemma-4-26b-a4b-it


K2_HORIZON_KEY="IFM-5IYBTRJwj2Y-CLyp"
K2_HORIZON_REASONING_EFFORT=medium
# Provider for agent.js specifically (tool-calling, single combined
# agent) — 'llama', 'openrouter', or 'gemini'. Set to 'openrouter' since
# it's noticeably faster than the local CPU-only llama-server and handles
# multi-hop tool calls more reliably. Switch back to 'llama' for
# privacy-sensitive local-only testing.
AGENT_LLM_PROVIDER=openrouter

# Provider for pipeline.js's two agents specifically — set each
# independently to 'llama' (local llama-server), 'openrouter', or 'gemini'.
# Only matters for pipeline.js (agent.js uses AGENT_LLM_PROVIDER above,
# query.js uses LLM_PROVIDER above).
KNOWLEDGE_PROVIDER=llama
# KNOWLEDGE_PROVIDER=openrouter
# KNOWLEDGE_PROVIDER=gemini
CONFIG_PROVIDER=llama
# CONFIG_PROVIDER=openrouter
# CONFIG_PROVIDER=gemini

# Provider for the live-diagnostics agent (liveAgent.js) — runs the actual
# show/ping/traceroute commands, delegated to by the sidebar's full agent
# via the run_live_diagnostics tool. Defaults to 'llama' for the same
# privacy-sensitivity reasoning as CONFIG_PROVIDER above (live device
# output, not just config text). Since the sidebar's outer agent already
# runs on OpenRouter for speed, consider setting this to 'openrouter' too
# if the local llama-server makes live checks feel slow there.
LIVE_PROVIDER=openrouter
# LIVE_PROVIDER=llama
# LIVE_PROVIDER=gemini

# Which embedding provider to use — uncomment ONE of these three lines:
# EMBED_PROVIDER=ollama
EMBED_PROVIDER=openrouter
# EMBED_PROVIDER=llamacpp

# Ollama was tried and removed — the remote box's Ollama-bundled
# llama-server subprocess crashed intermittently with "illegal
# instruction" and behaved inconsistently between localhost and the
# public IP. Left EMBED_HOST here only for reference.
EMBED_HOST=http://196.41.44.205:11434
OLLAMA_EMBED_MODEL=nomic-embed-text:v1.5

# EMBED_PROVIDER=llamacpp — routes embeddings through your own
# llama-server multi-model router (same LLM_HOST/LLM_API_KEY as chat),
# hitting whichever preset in presets.ini is named here. That preset must
# have `embedding = true` and the right `pooling` mode set (see
# presets.ini's own comments) — bge-large-en-v1.5 uses `pooling = cls`.
LLAMACPP_EMBED_MODEL=bge-large-en-v1.5

# Used when EMBED_PROVIDER=openrouter (reuses OPENROUTER_API_KEY above)
OPENROUTER_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# Your switch-config tool's API
CONFIG_API_HOST=http://10.169.209.217:4000
CONFIG_API_EMAIL=godwin.makyao@liquidtech.co.tz
CONFIG_API_PASSWORD="godwin842001!@#"

# How many chunks to retrieve per question. Lowered from 4 — since XML
# knowledge is now chunked by whole section (not char count), each chunk
# is bigger, so 4 of them adds a lot of context and slows down CPU-only
# llama-server generation for not much retrieval benefit. Raise this back
# up if answers seem to be missing relevant sections.
TOP_K=3

# Configs longer than this (in characters) get filtered down to the most
# relevant sections instead of being included in full. ~6000 chars is
# roughly 1500 tokens — raise this if your model has a large context
# window, lower it if you're getting truncation/context errors.
CONFIG_CHAR_LIMIT=6000

# --- Network warehouse (historical/trend data) ----------------------------
# get_link_history, get_current_status, and check_utilization_trend call
# the warehouse ingest API — same auth style as its /history endpoint: a
# single x-api-key header, not a login flow like CONFIG_API above.
WAREHOUSE_API_HOST=http://196.41.46.141:4000
WAREHOUSE_API_KEY="ncns8u49sd2ndnxcvnwjefnjjvjsnjvnjd"

# --- Shared knowledge base (office-wide) ---------------------------------
# search_knowledge_base and save_knowledge_correction now call a single
# shared knowledge-server (see knowledge-server/ in the junos-rag-assistant
# project) instead of using a local per-user copy of the knowledge base —
# every engineer's app queries the SAME index, and a correction one person
# saves is immediately visible to everyone else. Point these at wherever
# that service is hosted; ask whoever runs it for the API key.
KNOWLEDGE_API_HOST=http://196.41.44.205:8090
KNOWLEDGE_API_KEY="3f5fb3911258af825d6aaf9c4dfb9de8dbb819ffb1bbd130"
# Only needed to use Settings > Rebuild Index (a full wipe + re-ingest on
# the shared server) — leave blank unless you're the one administering the
# knowledge server. Everyone else can leave this out entirely.
KNOWLEDGE_ADMIN_KEY=
LAYA_URL=http://196.41.44.205:8000/v1/systemone
LAYA_API_KEY="bfefc539fb81e11f4b3749f3d6c50e6aa70c5f0d417ebe2aa88388cecaa238c2"